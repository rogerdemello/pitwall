# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Node
node_modules/
.next/
out/
*.tsbuildinfo

# Large generated artifacts
backend/clips/
backend/.fastf1_cache/
backend/raw/*.bak.json

# Precomputed race JSON is intentionally committed - it is what makes the demo
# work offline. backend/races/ is small (a few MB) and is the deliverable.
# backend/raw/ is committed too: it is the input to stage 2, so calibration and
# fusion can be re-tuned without re-running an hour of inference.

# Generated by push_to_hub.py. The dataset card is rendered from a template, so
# the payload is a build output, not source.
backend/hub_dataset/data/
backend/hub_dataset/messages.jsonl

# Generated by build_static_site.py for the static Space deploy (~40 MB).
# Regenerate with: python backend/data/build_static_site.py
frontend/public/data/
frontend/public/audio/
frontend/out/

# Copied in from backend/ by build_space_live.py. space_live/ owns app.py,
# README.md and requirements.txt; everything else there is a build artifact and
# backend/pipeline/ stays the only source.
space_live/pipeline/
space_live/_pooled.calibration.json

# Logs
frontend/dev*.log
backend/*.log
docker_build*.log

# One-off scratch driver, superseded by build_all.py
backend/_run_2023.py
